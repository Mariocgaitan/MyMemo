# Copia como .env y completa los valores

# URL base del backend (sin trailing slash)
MYMEMO_API_URL=https://tudominio.com

# Debe coincidir exactamente con ADMIN_API_KEY del backend
ADMIN_API_KEY=tu_admin_api_key_aqui

# Modo mock para desarrollar UI sin instancia disponible
USE_MOCK_DATA=false

# Timeout de requests HTTP al backend (segundos)
DASHBOARD_REQUEST_TIMEOUT_SEC=20

# Nota: el dashboard NO necesita credenciales AWS directamente.
# Los costos de AWS (Cost Explorer) y métricas de infra (CloudWatch)
# son consultados por el backend y expuestos via /admin/finops e /admin/infrastructure.

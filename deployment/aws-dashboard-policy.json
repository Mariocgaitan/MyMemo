{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3AccessForMyMemoBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::mymemo-images-prod-2026",
        "arn:aws:s3:::mymemo-images-prod-2026/*",
        "arn:aws:s3:::mymemo-thumbnails-prod-2026",
        "arn:aws:s3:::mymemo-thumbnails-prod-2026/*",
        "arn:aws:s3:::lifelogs-backups",
        "arn:aws:s3:::lifelogs-backups/*"
      ]
    },
    {
      "Sid": "CostExplorerReadOnly",
      "Effect": "Allow",
      "Action": [
        "ce:GetCostAndUsage",
        "ce:GetCostForecast"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchReadOnly",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricData",
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2ReadOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RDSReadOnly",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBInstances"
      ],
      "Resource": "*"
    }
  ]
}

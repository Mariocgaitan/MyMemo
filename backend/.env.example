# Database Configuration
DATABASE_URL=postgresql+asyncpg://lifelogs_user:lifelogs_pass@localhost:5432/lifelogs_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# AWS Configuration
# Usado para: S3 (imágenes/backups) + Cost Explorer (gastos) + CloudWatch (métricas de infra)
# IAM mínimo requerido: s3:*, ce:GetCostAndUsage, ce:GetCostForecast, cloudwatch:GetMetricData,
#                        ec2:DescribeInstances, rds:DescribeDBInstances
# En producción: usar Instance Profile en EC2 en lugar de access keys.
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1
S3_BUCKET_IMAGES=lifelogs-images-prod
S3_BUCKET_THUMBNAILS=lifelogs-thumbnails-prod
S3_BUCKET_BACKUPS=lifelogs-backups

# OpenAI Configuration
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500

# Face Recognition Configuration
FACE_RECOGNITION_TOLERANCE=0.6
FACE_RECOGNITION_MODEL=hog  # hog or cnn (cnn is more accurate but slower)

# Cost Management
MONTHLY_BUDGET_USD=50.00
ALERT_THRESHOLD_PERCENTAGE=80

# Security
SECRET_KEY=generate_a_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Settings
ENVIRONMENT=development
DEBUG=true
API_VERSION=v1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
MEMORY_CREATION_LIMIT_PER_HOUR=10
MEMORY_CREATION_LIMIT_PER_DAY=50

# Admin Dashboard
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=generate_a_random_admin_key_here

# Google Maps / Places API
# Consola: https://console.cloud.google.com → APIs & Services → Credenciales
# APIs a habilitar: Places API (New), Maps JavaScript API, Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Image Processing
MAX_IMAGE_SIZE_MB=10
THUMBNAIL_SIZE=400
IMAGE_QUALITY=85
